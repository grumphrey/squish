TZ="Pacific/Fiji"
POSTGRES_USER="myuser"
POSTGRES_PASSWORD="mypassword"
POSTGRES_DB="mydatabase"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"
REDIS_ADDRESS="redis:6379"
REDIS_PASSWORD="mypassword"
GEOIP_PATH="/var/lib/geoip/GeoLite2-City.mmdb"
JWT_ACCESS_SECRET="mysecret"
JWT_REFRESH_SECRET="mysecret"

GOOGLE_CLIENT_ID="myclientid"
GOOGLE_CLIENT_SECRET="myclientsecret"
GOOGLE_OAUTH_REDIRECT_URL="https://mydomain/api/auth/google/callback"

GITHUB_CLIENT_ID="myclientid"
GITHUB_CLIENT_SECRET="myclientsecret"
GITHUB_OAUTH_REDIRECT_URL="https://mydomain/api/auth/github/callback"
